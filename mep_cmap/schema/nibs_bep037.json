        "TMS",
        "tES",
        "TUS",
        "PNS"
      ],
      "advanced": false,
      "description": "Primary non-invasive brain stimulation modality applied during the recording.",
      "scope": "session",
      "block": "",
      "emits": "nibs_type",
      "legacy": true
    },
    {
      "key": "StimulationDescription",
      "modalities": [
        "common"
      ],
      "group": "parameters",
      "level": "recommended",
      "type": "string",
      "units": null,
      "enum": null,
