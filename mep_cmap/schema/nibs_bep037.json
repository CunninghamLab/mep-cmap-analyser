        "Monophasic",
        "Biphasic",
        "Halfsine",
        "Rectangle",
        "Sinusoid",
        "Noise",
        "Custom"
      ],
      "advanced": false,
      "description": "Waveform shape of the base stimulus, from the closed vocabulary in NIBS-BIDS v6.3. Monophasic/Biphasic/Halfsine apply to TMS; Rectangle covers square pulses (tES blocks and peripheral nerve stimulation); Sinusoid covers tACS and TUS carriers; Custom requires StimulusDescription.",
      "scope": "parameter_set",
      "block": "nibs.tsv",
      "emits": "stimulus_shape"
    },
