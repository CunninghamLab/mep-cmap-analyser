    },
    {
      "key": "StimulusDescription",
      "modalities": [
        "common"
      ],
      "group": "parameters",
      "level": "optional",
      "type": "string",
      "units": null,
      "enum": null,
      "advanced": true,
      "description": "Free-text description of a waveform not covered by the shape vocabulary. Required by v6.3 when PulseShape is 'Custom'.",
      "scope": "parameter_set",
      "block": "nibs.tsv",
      "emits": "stimulus_description"
    },
    {
      "key": "CurrentDirection",
      "modalities": [
        "TMS"
      ],
      "group": "device",
      "level": "optional",
      "type": "string",
      "units": null,
      "enum": [
        "cl",
        "co",
        "cl-co",
        "co-cl",
        "other"
      ],
      "advanced": false,
      "description": "Direction of current flow in the coil winding, from the closed vocabulary in NIBS-BIDS v6.3. Read in a fixed viewing frame: hold the coil with its stimulating face away from you and the handle pointing away, then report the flow in each wing as seen from the top face. 'cl' and 'co' describe a circular coil, clockwise and counterclockwise; 'cl-co' and 'co-cl' describe a figure-of-eight, naming the left wing then the right. Leave blank unless you know it — for the PA/AP convention reported in most TMS work, use InducedCurrentDirection.",
      "scope": "parameter_set",
      "block": "nibs.tsv",
      "emits": "current_direction"
    },
    {
      "key": "InducedCurrentDirection",
      "modalities": [
        "TMS"
      ],
      "group": "targeting",
      "level": "recommended",
      "type": "string",
      "units": null,
      "enum": [
        "PA",
        "AP",
        "LM",
        "ML",
        "other"
      ],
      "advanced": false,
      "description": "Direction of the current induced in the brain, the convention normally reported in TMS work. This is a consequence of coil geometry, handle orientation and winding direction rather than an independent setting, so v6.3 has no column for it: it is written into the placement description in *_markers.tsv. Not the same as CurrentDirection, which is the current in the coil winding.",
      "scope": "parameter_set",
      "block": "markers.tsv",
      "emits": "position_description"
    },
    {
